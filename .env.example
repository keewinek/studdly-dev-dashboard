# Base URL for the Flutter web preview build (deep links from the UI map).
# Local example: http://localhost:8080/
# Production example: https://dev.studdly.app/app/
# Backup: https://studdlydev.netlify.app/app/
VITE_FLUTTER_PREVIEW_URL=/app/

# ── /stats exact downloads (server-side / local script only — never VITE_*) ──
# Also set these as Netlify → Site configuration → Environment variables
# so /.netlify/functions/downloads can serve live totals.

# Google Play Console → Download reports → Statistics → Copy Cloud Storage URI
# PLAY_GCS_BUCKET=pubsite_prod_rev_01234567890987654321
# PLAY_PACKAGE_NAME=com.studdly.app
# PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account",...}   # or base64 of the JSON

# App Store Connect → Users and Access → Integrations → App Store Connect API
# ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ASC_KEY_ID=XXXXXXXXXX
# ASC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# ASC_VENDOR_NUMBER=12345678
# ASC_APPLE_ID=6755741754
# ASC_SKU=                     # optional SKU filter
# ASC_START_YEAR=2025
